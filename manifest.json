{
  "manifest_version": 3,
  "name": "Clipboard Viewer",
  "version": "1.0",
  "description": "A simple extension to view and manage clipboard content",
  "permissions": ["clipboardRead", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
} 